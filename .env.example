# Existing extension OAuth configuration (preserve in hosting)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional when using the existing default Dropbox app ID
DROPBOX_OAUTH_CLIENT_ID=
DROPBOX_OAUTH_CLIENT_SECRET=

# Existing RoamJS project in org jevettuehuhgoesqqhxc. Publishable values only.
NEXT_PUBLIC_SUPABASE_URL=https://uxihswugvmdwbbtgxtfl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable only in the accepted environment after applying the suggestion migration.
COMMUNITY_SUBMISSIONS_ENABLED=false
# Optional owner email notices. Apply the outbox migration first, then set a UTC
# activation timestamp so suggestions saved while disabled never send later.
SUGGESTION_NOTIFICATIONS_ENABLED=false
SUGGESTION_NOTIFICATION_TO=
SUGGESTION_NOTIFICATION_START_AT=
# Reuse the newsletter Supabase secret and Resend key declared below. Set a
# separate random CRON_SECRET for Vercel's retry endpoint.
CRON_SECRET=
# Newsletter server configuration: never use NEXT_PUBLIC_ for these secrets.
# Keep signup false until migration, protected-preview verification and activation approval.
NEWSLETTER_SIGNUP_ENABLED=false
SUPABASE_NEWSLETTER_SECRET_KEY=
NEWSLETTER_LINK_SECRET=
NEWSLETTER_SITE_URL=https://roamjs.com
RESEND_API_KEY=
# Optional analytics overrides. The site uses the public ingestion token for
# RoamJS PostHog project 648202 by default on hosted deployments.
# Set false to disable; set true to test on localhost. Never use a personal API key.
NEXT_PUBLIC_POSTHOG_ENABLED=
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
