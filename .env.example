# Existing extension OAuth configuration (preserve in hosting)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional when using the existing default Dropbox app ID
DROPBOX_OAUTH_CLIENT_ID=
DROPBOX_OAUTH_CLIENT_SECRET=

# Create a Clerk development application, enable email verification,
# and add the preview origin to its allowed origins. Never commit real keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Neon Postgres connection URL; apply db/001-community.sql before enabling forms.
DATABASE_URL=
